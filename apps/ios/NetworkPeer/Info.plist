    <key>NETWORKPEER_STRIPE_PUBLISHABLE_KEY</key>
    <string>$(NETWORKPEER_STRIPE_PUBLISHABLE_KEY)</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>NetworkPeer uses your current location to create jobs, find nearby jobs, and validate worker eligibility.</string>
    <key>NSCameraUsageDescription</key>
    <string>NetworkPeer uses the camera to capture evidence required for assigned work.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>NetworkPeer uses the microphone when you record video evidence for assigned work.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>NetworkPeer lets you select evidence required for assigned work.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.networkpeer.mobile</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>networkpeer</string>
            </array>
        </dict>
    </array>
